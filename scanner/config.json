{
  "description": "Scanner configuration. Primary scanner is Finviz (free). Twelve Data kept as backup for forex/crypto quotes.",

  "primary_scanner": {
    "stocks": "Finviz (free, unlimited) — trader-scan.js",
    "crypto": "CoinGecko (free, unlimited)",
    "charts": "TradingView MCP (free, unlimited)"
  },

  "backup_provider": "twelve-data",

  "providers": {
    "twelve-data": {
      "name": "Twelve Data",
      "env_key": "TWELVE_DATA_API_KEY",
      "env_file": "/Users/mariashchekanenko/claude-trading-broker/.env",
      "base_url": "https://api.twelvedata.com",
      "rate_limit": "8 requests per minute (free)",
      "note": "Backup only — use Finviz/CoinGecko/TradingView instead"
    }
  },

  "symbol_mapping": {
    "description": "Maps internal symbols to Twelve Data format. Only needed for backup quotes.",
    "twelve-data": {
      "XAUUSD": "XAU/USD",
      "XAGUSD": "XAG/USD",
      "USDJPY": "USD/JPY",
      "EURUSD": "EUR/USD",
      "GBPUSD": "GBP/USD",
      "BTCUSD": "BTC/USD",
      "ETHUSD": "ETH/USD",
      "SOLUSD": "SOL/USD",
      "RENDERUSD": "RENDER/USD",
      "FETUSD": "FET/USD",
      "TAOUSD": "TAO/USD"
    }
  }
}
