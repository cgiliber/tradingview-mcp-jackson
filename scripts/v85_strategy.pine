//@version=6
strategy("v8.5 Supply Demand AUTO", overlay=true, max_bars_back=500,
     default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     initial_capital=100000, commission_type=strategy.commission.percent,
     commission_value=0.1, process_orders_on_close=true)

// INPUTS
length = input.int(10, "Swing Length")
minRR = input.float(2.5, "Min Risk:Reward")
persistMinutes = input.int(60, "Signal Persist (minutes)")

// AUTO-ADAPT persist based on timeframe
barsPerPersist = math.max(1, math.round(persistMinutes * 60 / timeframe.in_seconds()))

// VALID STRUCTURE — pivot-based swing tracking
pivHigh = ta.pivothigh(high, length, length)
pivLow = ta.pivotlow(low, length, length)

var float swingHigh = na
var float swingLow = na
var int trendDir = 0

if not na(pivHigh) and (na(swingHigh) or pivHigh != swingHigh)
    swingHigh := pivHigh
if not na(pivLow) and (na(swingLow) or pivLow != swingLow)
    swingLow := pivLow

if not na(swingHigh) and not na(swingLow)
    if close > swingHigh
        trendDir := 1
    if close < swingLow
        trendDir := -1

// SUPPLY & DEMAND ZONES
bodySize = math.abs(close - open)
avgBody = ta.sma(bodySize, 14)
isImpulseUp = (close - open) > avgBody * 2 and close > open
isImpulseDown = (open - close) > avgBody * 2 and close < open

var float zoneHigh = na
var float zoneLow = na
var int zoneType = 0
var bool zoneActive = false

if isImpulseUp and trendDir == 1
    zoneHigh := high[1]
    zoneLow := low[1]
    zoneType := 1
    zoneActive := true

if isImpulseDown and trendDir == -1
    zoneHigh := high[1]
    zoneLow := low[1]
    zoneType := -1
    zoneActive := true

// SIGNALS with R:R check
buySignal = false
sellSignal = false
var float entryPrice = na
var float stopPrice = na
var float tpPrice = na

if zoneActive and zoneType == 1 and trendDir == 1 and low <= zoneHigh and close > zoneLow
    stopDist = zoneHigh - zoneLow
    reward = nz(swingHigh, close) - zoneHigh
    if stopDist > 0 and reward / stopDist >= minRR
        buySignal := true
        entryPrice := zoneHigh
        stopPrice := zoneLow
        tpPrice := zoneHigh + reward
        zoneActive := false

if zoneActive and zoneType == -1 and trendDir == -1 and high >= zoneLow and close < zoneHigh
    stopDist = zoneHigh - zoneLow
    reward = zoneLow - nz(swingLow, close)
    if stopDist > 0 and reward / stopDist >= minRR
        sellSignal := true
        entryPrice := zoneLow
        stopPrice := zoneHigh
        tpPrice := zoneLow - reward
        zoneActive := false

// ═══════════════════════════════════════════
// AUTO-EXECUTE TRADES — no GUI clicks needed
// ═══════════════════════════════════════════

if buySignal and strategy.position_size == 0
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY_EXIT", "BUY", limit=tpPrice, stop=stopPrice)

if sellSignal and strategy.position_size == 0
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL_EXIT", "SELL", limit=tpPrice, stop=stopPrice)

// PLOTS
plot(swingHigh, "Swing High", color.red, 1, plot.style_stepline)
plot(swingLow, "Swing Low", color.green, 1, plot.style_stepline)
plotshape(buySignal, "BUY", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(sellSignal, "SELL", shape.triangledown, location.abovebar, color.red, size=size.normal)
bgcolor(trendDir == 1 ? color.new(color.green, 95) : trendDir == -1 ? color.new(color.red, 95) : na)
