//@version=6
indicator("Maria's Universal Strategy 3.1", overlay=true, max_labels_count=50, max_boxes_count=20)

// ══════════════════════════════════════════════════════════════
// v3.1 FIXES:
// - Added lookahead=barmerge.lookahead_off to all request.security() calls
// - Added barstate.isconfirmed to prevent mid-bar signal repainting
// - Signals only fire on confirmed (closed) bars
// ══════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════
// ASSET TYPE DETECTION
// ══════════════════════════════════════════════════════════════

f_detectAssetType() =>
    sym = str.upper(syminfo.ticker)
    typ = syminfo.type

    if str.contains(sym, "BTC") or str.contains(sym, "ETH") or str.contains(sym, "SOL") or str.contains(sym, "FET") or str.contains(sym, "RENDER") or str.contains(sym, "TAO") or str.contains(sym, "XRP") or str.contains(sym, "BNB") or str.contains(sym, "ADA") or str.contains(sym, "AVAX") or str.contains(sym, "LINK") or str.contains(sym, "AR") or str.contains(sym, "OCEAN") or str.contains(sym, "AGIX") or str.contains(sym, "WLD") or typ == "crypto"
        "crypto"
    else if (str.contains(sym, "EUR") and str.contains(sym, "USD")) or (str.contains(sym, "GBP") and str.contains(sym, "USD")) or (str.contains(sym, "USD") and str.contains(sym, "JPY")) or (str.contains(sym, "EUR") and str.contains(sym, "GBP")) or (str.contains(sym, "GBP") and str.contains(sym, "JPY")) or (str.contains(sym, "AUD") and str.contains(sym, "USD")) or (str.contains(sym, "USD") and str.contains(sym, "CHF")) or typ == "forex"
        "forex"
    else if str.contains(sym, "XAU") or str.contains(sym, "XAG") or str.contains(sym, "GOLD") or str.contains(sym, "SILVER") or str.contains(sym, "OIL") or str.contains(sym, "WTICO") or str.contains(sym, "UKOIL") or str.contains(sym, "NATGAS") or str.contains(sym, "COPPER") or str.contains(sym, "COPP") or str.contains(sym, "CL1!") or str.contains(sym, "GC1!") or typ == "commodity" or typ == "cfd"
        "commodity"
    else if str.contains(sym, "SPX") or str.contains(sym, "SPY") or str.contains(sym, "QQQ") or str.contains(sym, "NAS100") or str.contains(sym, "US30") or str.contains(sym, "GER40") or str.contains(sym, "DXY") or str.contains(sym, "ES1!") or str.contains(sym, "NQ1!") or str.contains(sym, "YM1!") or typ == "index"
        "index"
    else
        "stock"

assetType = f_detectAssetType()

// ══════════════════════════════════════════════════════════════
// INDICATORS — used across strategies
// ══════════════════════════════════════════════════════════════

ema8   = ta.ema(close, 8)
ema20  = ta.ema(close, 20)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
ema55  = ta.ema(close, 55)
ema200 = ta.ema(close, 200)

rsi14 = ta.rsi(close, 14)

[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

[bbMid, bbUpper, bbLower] = ta.bb(close, 20, 2)
bbWidth     = bbUpper - bbLower
bbWidthPrev = ta.highest(bbWidth, 20)
bbSqueeze   = bbWidth <= bbWidthPrev * 0.5

volAvg20 = ta.sma(volume, 20)
highVol  = volume > volAvg20

// FIX #1: Added lookahead=barmerge.lookahead_off
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

bodySize  = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
totalRange = high - low
bullPinBar = totalRange > 0 and lowerWick > bodySize * 2 and upperWick < bodySize * 0.5
bearPinBar = totalRange > 0 and upperWick > bodySize * 2 and lowerWick < bodySize * 0.5

// ══════════════════════════════════════════════════════════════
// STRATEGY SIGNALS — from rules.json
// ══════════════════════════════════════════════════════════════

fx1_long  = close > prevDayHigh and ema20 > ema20[1]
fx1_short = close < prevDayLow and ema20 < ema20[1]

fx2_long  = ta.crossover(ema8, ema21) and rsi14 > 50 and close > ema8 and close > ema21
fx2_short = ta.crossunder(ema8, ema21) and rsi14 < 50

fx3_long  = bullPinBar and close > ema50
fx3_short = bearPinBar and close < ema50

idx1_long  = close > ema200 and ema50 > ema200 and rsi14 >= 40 and rsi14 <= 50
idx1_short = close < ema200 and rsi14 >= 50 and rsi14 <= 60

// FIX #1: Added lookahead=barmerge.lookahead_off
weeklyEma13   = request.security(syminfo.tickerid, "W", ta.ema(close, 13), lookahead=barmerge.lookahead_off)
weeklyTrendUp = close > weeklyEma13
idx2_long  = weeklyTrendUp and macdHist > 0 and macdHist[1] <= 0
idx2_short = not weeklyTrendUp and macdHist < 0 and macdHist[1] >= 0

cmd1_long  = close > ema50
cmd1_short = close < ema50

cmd2_long  = bbSqueeze[1] and close > bbUpper and highVol
cmd2_short = bbSqueeze[1] and close < bbLower and highVol

cmd3_long  = ema20 > ema50
cmd3_short = ema20 < ema50

btc1_long  = ta.crossover(ema50, ema200)
btc1_short = ta.crossunder(ema50, ema200)

btc2_long  = ta.crossover(ema21, ema55) and rsi14 > 50
btc2_short = ta.crossunder(ema21, ema55) and rsi14 < 50

alt1_long  = ta.crossover(macdLine, signalLine) and highVol
alt1_short = ta.crossunder(macdLine, signalLine) and highVol

// ══════════════════════════════════════════════════════════════
// COMBINE SIGNALS BY ASSET TYPE
// ══════════════════════════════════════════════════════════════

buySignal  = false
sellSignal = false
activeStrat = ""

if assetType == "forex"
    if fx1_long or fx2_long or fx3_long
        buySignal := true
        activeStrat := fx1_long ? "FX-1 Breakout" : fx2_long ? "FX-2 EMA Cross" : "FX-3 Pin Bar"
    if fx1_short or fx2_short or fx3_short
        sellSignal := true
        activeStrat := fx1_short ? "FX-1 Breakout" : fx2_short ? "FX-2 EMA Cross" : "FX-3 Pin Bar"

else if assetType == "stock" or assetType == "index"
    if idx1_long or idx2_long
        buySignal := true
        activeStrat := idx1_long ? "IDX-1 RSI Pullback" : "IDX-2 Triple Screen"
    if idx1_short or idx2_short
        sellSignal := true
        activeStrat := idx1_short ? "IDX-1 RSI Pullback" : "IDX-2 Triple Screen"

else if assetType == "commodity"
    if cmd1_long or cmd2_long or cmd3_long
        buySignal := true
        activeStrat := cmd2_long ? "CMD-2 BB Squeeze" : cmd1_long ? "CMD-1 EMA Trend" : "CMD-3 Oil EMA"
    if cmd1_short or cmd2_short or cmd3_short
        sellSignal := true
        activeStrat := cmd2_short ? "CMD-2 BB Squeeze" : cmd1_short ? "CMD-1 EMA Trend" : "CMD-3 Oil EMA"

else if assetType == "crypto"
    isBTC = str.contains(str.upper(syminfo.ticker), "BTC")
    if isBTC
        if btc1_long or btc2_long
            buySignal := true
            activeStrat := btc1_long ? "BTC-1 Golden Cross" : "BTC-2 EMA 21/55"
        if btc1_short or btc2_short
            sellSignal := true
            activeStrat := btc1_short ? "BTC-1 Death Cross" : "BTC-2 EMA 21/55"
    else
        if alt1_long or btc2_long
            buySignal := true
            activeStrat := alt1_long ? "ALT-1 MACD Vol" : "BTC-2 EMA 21/55"
        if alt1_short or btc2_short
            sellSignal := true
            activeStrat := alt1_short ? "ALT-1 MACD Vol" : "BTC-2 EMA 21/55"

// ══════════════════════════════════════════════════════════════
// FIX #2: CONFIRMED SIGNALS — prevent mid-bar repainting
// ══════════════════════════════════════════════════════════════

confirmedBuy  = buySignal and not buySignal[1] and barstate.isconfirmed
confirmedSell = sellSignal and not sellSignal[1] and barstate.isconfirmed

// ══════════════════════════════════════════════════════════════
// PLOT INDICATORS
// ══════════════════════════════════════════════════════════════

plot(ema8,   "EMA 8",   color=color.new(color.yellow, 70), linewidth=1)
plot(ema21,  "EMA 21",  color=color.new(color.orange, 50), linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(color.blue, 50),   linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red, 50),    linewidth=2)

p_bbU = plot(bbUpper, "BB Upper", color=color.new(color.gray, 70))
p_bbL = plot(bbLower, "BB Lower", color=color.new(color.gray, 70))
fill(p_bbU, p_bbL, color=bbSqueeze ? color.new(color.yellow, 90) : color.new(color.gray, 95))

plot(prevDayHigh, "Prev Day High", color=color.new(color.green, 60), style=plot.style_stepline)
plot(prevDayLow,  "Prev Day Low",  color=color.new(color.red, 60),   style=plot.style_stepline)

// ══════════════════════════════════════════════════════════════
// SIGNAL ARROWS — using confirmed signals only
// ══════════════════════════════════════════════════════════════

plotshape(confirmedBuy, title="BUY", location=location.belowbar, style=shape.triangleup, size=size.small, color=color.green, text="BUY")
plotshape(confirmedSell, title="SELL", location=location.abovebar, style=shape.triangledown, size=size.small, color=color.red, text="SELL")

// Data window outputs
plot(confirmedBuy ? 1 : 0, "BUY_SIGNAL", display=display.data_window)
plot(confirmedSell ? 1 : 0, "SELL_SIGNAL", display=display.data_window)
plot(buySignal ? 1 : 0, "RAW_BUY", display=display.data_window)
plot(sellSignal ? 1 : 0, "RAW_SELL", display=display.data_window)

// ══════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ══════════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "Maria's Strategy 3.1", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))

    table.cell(dash, 0, 1, "Asset Type", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, str.upper(assetType), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 2, "Strategy", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, activeStrat != "" ? activeStrat : "None active", text_color=activeStrat != "" ? color.yellow : color.gray, text_size=size.tiny)

    sigText = buySignal ? "BUY" : sellSignal ? "SELL" : "FLAT"
    sigColor = buySignal ? color.green : sellSignal ? color.red : color.gray
    table.cell(dash, 0, 3, "Signal", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, sigText, text_color=sigColor, text_size=size.small)

    rsiColor = rsi14 > 70 ? color.red : rsi14 < 30 ? color.green : color.white
    table.cell(dash, 0, 4, "RSI 14", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(rsi14, "#.#"), text_color=rsiColor, text_size=size.tiny)

    macdColor = macdHist > 0 ? color.green : color.red
    table.cell(dash, 0, 5, "MACD Hist", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(macdHist, "#.###"), text_color=macdColor, text_size=size.tiny)

    trendText = ema50 > ema200 ? "BULL" : "BEAR"
    trendColor = ema50 > ema200 ? color.green : color.red
    table.cell(dash, 0, 6, "EMA 50/200", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, trendText, text_color=trendColor, text_size=size.tiny)

    aboveKey = close > ema50 and close > ema200
    belowKey = close < ema50 and close < ema200
    posText = aboveKey ? "Above Both" : belowKey ? "Below Both" : "Between"
    posColor = aboveKey ? color.green : belowKey ? color.red : color.yellow
    table.cell(dash, 0, 7, "Price vs EMAs", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, posText, text_color=posColor, text_size=size.tiny)

    table.cell(dash, 0, 8, "BB Squeeze", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, bbSqueeze ? "YES" : "No", text_color=bbSqueeze ? color.yellow : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 9, "Volume", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, highVol ? "HIGH" : "Normal", text_color=highVol ? color.green : color.gray, text_size=size.tiny)
